{
  "name": "starter-tauri-v3",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "description": "Experimental Tauri v3 starter",
  "author": "hairyf",
  "license": "MIT",
  "homepage": "https://github.com/hairyf/starter-tauri-v3#readme",
  "repository": {
    "type": "git",
